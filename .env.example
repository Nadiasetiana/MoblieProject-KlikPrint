# Isi dengan data dari Supabase: Project Settings -> API (atau tombol "Connect")
# Jangan pakai tanda kutip. Setelah mengubah file ini, jalankan ulang: npx expo start -c
EXPO_PUBLIC_SUPABASE_URL=https://ISI-PROJECT-ID-KAMU.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ISI-ANON-ATAU-PUBLISHABLE-KEY-KAMU
